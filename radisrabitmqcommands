# for create a new user inside Docker:
docker exec -it rabbitmq rabbitmqctl add_user admin admin123
docker exec -it rabbitmq rabbitmqctl set_user_tags admin administrator
docker exec -it rabbitmq rabbitmqctl set_permissions -p / admin ".*" ".*" ".*"


PowerShell command, For create a new rabitmq plugin in:

docker run -d --name rabbitmq -p 5672:5672 -p 15672:15672 rabbitmq:3-management

Linux command, For create a new rabitmq plugin in:
docker run -d --name rabbitmq \
  -p 5672:5672 \
  -p 15672:15672 \
  rabbitmq:3-management


